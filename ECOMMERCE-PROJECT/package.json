{
  "name": "ecommerce-website",
  "version": "1.0.0",
  "description": "A full-stack e-commerce website",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "node backend/server.js",
    "server:dev": "nodemon backend/server.js",
    "client": "npm --prefix frontend start",
    "dev": "concurrently \"npm:server:dev\" \"npm:client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^9.0.1"
  }
}
